# ============================================
# 交通数据分析平台 - 环境变量示例
# 复制为 .env 使用（.env 已被 git 忽略）
# ============================================

# HTTP 服务监听地址
SERVER_ADDR=:8080

# PostgreSQL 连接串
DATABASE_URL=postgres://traffic:traffic@localhost:5432/traffic?sslmode=disable

# 拥堵指数自由流速度（km/h）
FREE_FLOW_SPEED=60.0

# 低速告警阈值（km/h）
LOW_SPEED_THRESHOLD=20.0

# 流量突增告警倍数阈值
FLOW_SPIKE_FACTOR=1.5

# 连续低速告警所需连续窗口数
LOW_SPEED_CONSECUTIVE=3
